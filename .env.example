# AI Provider selection: openai | gemini | groq
# Auto-detection priority when unset: OPENAI_API_KEY (openai) -> GOOGLE_GEMINI_API_KEY (gemini) -> GROQ_API_KEY (groq).
# Set AI_PROVIDER explicitly to choose a specific provider when multiple keys exist.
# AI_PROVIDER=gemini

# Image generation provider: cloudflare | openai
# Auto-detection priority when unset: Cloudflare (if keys present) -> OpenAI.
# IMAGE_PROVIDER=cloudflare

# Google Gemini
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_MODEL=gemini-3.5-flash

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Cloudflare Workers AI (Image generation: FLUX.1)
CLOUDFLARE_AI_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# OpenAI
# Note: --research auto|required requires OPENAI_API_KEY because it relies on OpenAI-hosted web search.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_IMAGE_MODEL=gpt-image-2

# Remotion browser executable (required on macOS)
# REMOTION_BROWSER_EXECUTABLE="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"